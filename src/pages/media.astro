---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { mediaImages } from '../data/media';

const visibleImages = mediaImages.filter((image) => image.visible !== false);
---

<BaseLayout title="Media — Splatter Phoenix" description="Official photos and live images from Splatter Phoenix.">
  <PageHero eyebrow="Photos" title="Media" intro="Shows, Richmond, and whatever happened before or after" />
  <section class="shell media-grid section-pad">
    {visibleImages.map((image) => <figure class={image.layout ?? 'standard'}><img src={image.src} alt={image.alt} loading="lazy" /></figure>)}
  </section>
  <section class="shell media-note"><p>Need a high-res photo? Grab the press kit or send us a message</p><a class="text-link" href="/press">Press kit <span>→</span></a></section>
</BaseLayout>
