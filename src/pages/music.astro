---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SpotifyPlayer from '../components/SpotifyPlayer.astro';

const releases = [
  { title: 'Cute On Blaire', type: 'EP', year: '2026', className: 'release-placeholder red', copy: 'The newest one. Four songs, no filler.' },
  { title: 'Heck Yes', type: 'Single', year: '2026', className: 'release-placeholder violet', copy: 'Quick, loud, and exactly what the title says.' },
  { title: 'No Time To Waste', type: 'EP', year: '2025', image: '/images/no-time-to-waste.png', copy: 'The first EP. Five songs that still hit.' },
];
---

<BaseLayout title="Music — Splatter Phoenix" description="Listen to releases from Richmond alternative pop punk band Splatter Phoenix.">
  <PageHero eyebrow="Press play" title="Music" intro="EPs, singles, and everything else we’ve put out" />
  <section class="shell music-player-block">
    <div><p class="eyebrow">Listen here</p><h2>Pick a song</h2><p>Or open Spotify if that’s more your thing</p></div>
    <SpotifyPlayer />
  </section>
  <section class="shell release-catalog section-pad">
    {releases.map((release) => (
      <article class="catalog-card">
        {release.image ? <img src={release.image} alt={`${release.title} cover art`} loading="lazy" /> : <div class={release.className}><img src="/images/phoenix-mark.png" alt="" /></div>}
        <div class="catalog-copy">
          <p class="eyebrow">{release.type} · {release.year}</p>
          <h2>{release.title}</h2>
          <p>{release.copy}</p>
          <div class="platform-links">
            <a href="https://open.spotify.com/artist/6QRLxRL3nlmg09obN0sYvc" target="_blank" rel="noreferrer">Spotify ↗</a>
            <a href="https://music.apple.com/us/artist/splatter-phoenix/1842780882" target="_blank" rel="noreferrer">Apple ↗</a>
            <a href="https://splatterphoenix.bandcamp.com/" target="_blank" rel="noreferrer">Bandcamp ↗</a>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
