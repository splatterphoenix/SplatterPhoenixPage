---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpotifyPlayer from '../components/SpotifyPlayer.astro';

const platforms = [
  ['Spotify', 'https://open.spotify.com/artist/6QRLxRL3nlmg09obN0sYvc'],
  ['Apple Music', 'https://music.apple.com/us/artist/splatter-phoenix/1842780882'],
  ['Bandcamp', 'https://splatterphoenix.bandcamp.com/'],
  ['YouTube', 'https://www.youtube.com/@SplatterPhoenix'],
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-photo" role="img" aria-label="Splatter Phoenix in Richmond, Virginia"></div>
    <div class="hero-scrim"></div>
    <div class="hero-copy shell">
      <p class="eyebrow hero-kicker">RVA · Alternative pop punk</p>
      <div class="hero-lockup">
        <div class="hero-emblem"><img class="hero-mark" src="/images/phoenix-mark.png" alt="Splatter Phoenix phoenix mark" /></div>
        <div class="hero-message">
          <p class="hero-line">Big hooks · Open hearts<br />No time to waste</p>
          <div class="button-row">
            <a class="button button-hot" href="#listen">Play the songs <span>↓</span></a>
            <a class="button button-ghost" href="/shows">See shows</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label="Band highlights">
    <div class="ticker-track">
      <span>Cute on Blaire</span><i>✦</i><span>No Time To Waste</span><i>✦</i><span>RVA Pop Punk</span><i>✦</i>
      <span>Cute on Blaire</span><i>✦</i><span>No Time To Waste</span><i>✦</i><span>RVA Pop Punk</span><i>✦</i>
    </div>
  </div>

  <section id="listen" class="home-music shell section-pad">
    <div class="section-head home-music-head">
      <div><p class="eyebrow">Out now</p><h2>Two EPs<br />No filler</h2></div>
      <p>Start with the new one or run it back to the first EP</p>
    </div>
    <div class="home-releases">
      <article class="home-release home-release-new">
        <div class="home-release-art cute-art">
          <img src="/images/phoenix-mark.png" alt="" />
          <span>Cute On Blaire</span>
        </div>
        <div class="home-release-copy">
          <p class="eyebrow">Latest EP · 2026</p>
          <h3>Cute On Blaire</h3>
          <ul class="mini-track-list">
            <li>Packed</li><li>Call My Name</li><li>Second Time Shame On Me</li><li>Another Day</li>
          </ul>
        </div>
      </article>
      <article class="home-release">
        <div class="home-release-art"><img src="/images/no-time-to-waste.png" alt="No Time To Waste cover art" loading="lazy" /></div>
        <div class="home-release-copy">
          <p class="eyebrow">EP · 2025</p>
          <h3>No Time To Waste</h3>
          <ul class="mini-track-list">
            <li>Used To Be</li><li>Not Alone</li><li>Online Girl</li><li>Memories</li><li>Hometown</li>
          </ul>
        </div>
      </article>
    </div>
    <div class="listen-row">
      <div><p class="eyebrow">Press play</p><h3>Listen right here</h3><p>No new tab required</p></div>
      <SpotifyPlayer compact />
    </div>
    <div class="platform-links home-platforms">
      {platforms.map(([label, href]) => <a href={href} target="_blank" rel="noreferrer">{label} ↗</a>)}
    </div>
  </section>

  <section class="manifesto section-pad">
    <div class="shell manifesto-grid">
      <p class="eyebrow">Three friends from Richmond</p>
      <h2 class="display-wide"><span>Songs that hit</span><em>Where it hurts</em></h2>
      <div class="manifesto-body">
        <p class="lead">We’re Josh, Ted, and Stephen. We make pop punk in Richmond and try not to overthink it.</p>
        <div class="manifesto-notes">
          <span>Loud guitars</span><span>Big choruses</span><span>Made in RVA</span>
        </div>
        <a class="text-link" href="/about">More about us <span>→</span></a>
      </div>
      <figure class="manifesto-photo"><img src="/images/band-stairs.jpg" alt="Splatter Phoenix together in Richmond" loading="lazy" /></figure>
    </div>
  </section>

  <section class="live-strip section-pad shell">
    <div class="section-head">
      <div><p class="eyebrow">At the shows</p><h2>Live stuff</h2></div>
      <a class="text-link" href="/media">More photos <span>→</span></a>
    </div>
    <div class="photo-grid">
      <figure class="photo-card photo-tall"><img src="/images/live-drums.jpg" alt="Splatter Phoenix performing live" loading="lazy" /><figcaption>RVA · Live</figcaption></figure>
      <figure class="photo-card"><img src="/images/live-full-band.jpg" alt="Splatter Phoenix on stage" loading="lazy" /><figcaption>On stage</figcaption></figure>
      <figure class="photo-card"><img src="/images/live-guitar.jpg" alt="Guitarist performing under magenta stage lights" loading="lazy" /><figcaption>Turn it up</figcaption></figure>
    </div>
  </section>

  <section class="show-callout shell section-pad">
    <div class="show-poster">
      <p class="eyebrow">Next show</p>
      <h2>New shows<br />coming soon</h2>
      <p>We’ll post the next one here as soon as it’s locked in</p>
      <a class="button button-dark" href="/shows">Shows</a>
    </div>
    <div class="show-photo"><img src="/images/band-city.jpg" alt="Splatter Phoenix walking through Richmond" loading="lazy" /></div>
  </section>

  <section class="final-cta section-pad">
    <div class="shell">
      <p class="eyebrow">Want us on a bill?</p>
      <h2>Hit us up</h2>
      <div class="button-row">
        <a class="button button-hot" href="/contact">Book the band</a>
        <a class="button button-ghost" href="https://www.instagram.com/splatter_phoenix_rva/" target="_blank" rel="noreferrer">Follow on Instagram ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
