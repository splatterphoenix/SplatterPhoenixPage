---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="About — Splatter Phoenix" description="Meet Josh, Ted, and Stephen of Richmond alternative pop punk band Splatter Phoenix.">
  <PageHero eyebrow="Josh · Ted · Stephen" title="We’re Splatter Phoenix" intro="Three friends making pop punk in Richmond. That’s the short version" />
  <section class="shell about-feature section-pad">
    <div class="about-image"><img src="/images/band-stairs.jpg" alt="Josh, Ted, and Stephen of Splatter Phoenix in Richmond" /></div>
    <div class="about-copy">
      <p class="eyebrow">The slightly longer version</p>
      <h2>We write songs and play them loud</h2>
      <p class="lead">Splatter Phoenix is Josh, Ted, and Stephen. We started this because we like making music together. Simple as that.</p>
      <p>The songs are melodic, loud, and usually a little too honest. We’re based in Richmond and we’re always working on the next one.</p>
    </div>
  </section>
  <section class="member-strip">
    <div class="shell member-grid">
      {['Josh', 'Ted', 'Stephen'].map((name) => <article><h2>{name}</h2><p>In the band</p></article>)}
    </div>
  </section>
</BaseLayout>
