---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { upcomingShows, pastShows } from '../data/shows';
---

<BaseLayout title="Shows — Splatter Phoenix" description="Upcoming shows and past dates from Splatter Phoenix in Richmond, Virginia.">
  <PageHero eyebrow="Come hang" title="Shows" intro="If we’ve got a date booked, it’ll be here" />
  <section class="shell shows-layout section-pad">
    <div class="upcoming-shows">
      <p class="eyebrow">Upcoming</p>
      {upcomingShows.length > 0 ? (
        <div class="show-list">
          {upcomingShows.map((show) => (
            <article class="show-row">
              <time datetime={show.date}>{show.displayDate}</time>
              <div><h2>{show.venue}</h2><p>{show.city}{show.details ? ` · ${show.details}` : ''}</p></div>
              {show.ticketUrl ? <a class="button button-hot" href={show.ticketUrl} target="_blank" rel="noreferrer">Tickets ↗</a> : <span class="show-status">Details soon</span>}
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-show">
          <p class="huge-date">TBA</p>
          <h2>Nothing locked in yet</h2>
          <p>We’re working on the next one. Follow us for the announcement or hit us up if you want us on a bill.</p>
          <div class="button-row"><a class="button button-hot" href="https://www.instagram.com/splatter_phoenix_rva/" target="_blank" rel="noreferrer">Follow for dates ↗</a><a class="button button-ghost" href="/contact">Book the band</a></div>
        </div>
      )}
    </div>
    <aside class="past-shows">
      <p class="eyebrow">Been there</p>
      <h2>Old shows</h2>
      {pastShows.map((show) => <div class="past-show"><time datetime={show.date}>{show.displayDate}</time><strong>{show.venue}</strong><span>{show.city}</span></div>)}
    </aside>
  </section>
</BaseLayout>
