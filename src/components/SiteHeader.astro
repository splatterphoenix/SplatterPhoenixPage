---
const currentPath = Astro.url.pathname;
const links = [
  ['/music', 'Music'],
  ['/shows', 'Shows'],
  ['/about', 'About'],
  ['/media', 'Media'],
  ['/contact', 'Contact'],
];
---

<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="Splatter Phoenix home">
    <img src="/images/sp-initials.png" alt="" />
    <span>Splatter Phoenix</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span></span><span></span>
    <span class="sr-only">Open navigation</span>
  </button>

  <nav id="site-nav" class="site-nav" aria-label="Main navigation">
    {links.map(([href, label]) => (
      <a class:list={{ active: currentPath === href }} href={href}>{label}</a>
    ))}
    <a class="nav-cta" href="https://open.spotify.com/artist/6QRLxRL3nlmg09obN0sYvc" target="_blank" rel="noreferrer">Listen ↗</a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = header?.querySelector('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
